# ─────────────────────────────────────────────────────────────────
# Local / App Service environment configuration — EXAMPLE / TEMPLATE
# ─────────────────────────────────────────────────────────────────
# Copy this file to `.env` (git-ignored — never commit real values) and
# fill in your environment, or run:
#
#   python3 scripts/configure.py
#
# which generates `.env` for you interactively or from CLI flags/an
# answers file. This example file is never modified by that script.
#
# In production (Azure App Service), these are set as App Service
# Application Settings by infra/main.bicep — this file documents them
# for local development and reference.
# ─────────────────────────────────────────────────────────────────

# Which checked-in profile (profiles/<id>/) to load. Defaults to "oge"
# (this app's original branding/agents) if unset. Ships with "generic"
# too — a neutral starting point for a new customer/profile.
APP_PROFILE=oge

# ── Azure OpenAI — primary/default ────────────────────────────────
# Endpoint used by any agent that doesn't specify a more specific one.
AZURE_OPENAI_ENDPOINT=https://<YOUR_OPENAI_ACCOUNT>.openai.azure.com/
# Deployment name used when an agent doesn't specify its own.
AZURE_OPENAI_DEPLOYMENT=foundry-gpt
# API version used for chat completions calls unless an agent overrides it.
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── Azure OpenAI — additional named endpoints (optional) ──────────
# "secondary" is a first-class optional slot for a second account/region.
# Any AZURE_OPENAI_ENDPOINT_<NAME> also works and can be referenced from
# an agent's endpoint_ref (profile.json) or AGENT_<KEY>_ENDPOINT=<name>.
AZURE_OPENAI_ENDPOINT_SECONDARY=

# ── Per-agent overrides (all optional; profile defaults apply otherwise) ──
# Agent keys: ORCHESTRATOR, COST_SENTINEL, STANDARDS_ARCHITECT,
#             DIAGNOSTICS_SRE, SCOUT, COMPLIANCE_INSPECTOR
# Each supports: _NAME, _ROLE, _DEPLOYMENT, _ENDPOINT, _TEMPERATURE,
#                _SUPPORTS_TEMPERATURE, _API_VERSION, _PROMPT_FILE
# _ENDPOINT accepts "primary", "secondary", any other AZURE_OPENAI_ENDPOINT_<NAME>,
# or a literal https:// URL.
#
# Examples (uncomment/edit as needed):
# AGENT_ORCHESTRATOR_DEPLOYMENT=foundry-gpt
# AGENT_ORCHESTRATOR_ENDPOINT=secondary
# AGENT_COST_SENTINEL_DEPLOYMENT=foundry-reasoning
# AGENT_COST_SENTINEL_SUPPORTS_TEMPERATURE=true
# AGENT_COST_SENTINEL_TEMPERATURE=0.2

# ── Azure environment ───────────────────────────────────────────────
AZURE_CLIENT_ID=<MANAGED_IDENTITY_CLIENT_ID>
AZURE_SUBSCRIPTION_ID=<YOUR_SUBSCRIPTION_ID>
KEY_VAULT_URI=https://<PREFIX>-kv.vault.azure.net/
LOG_ANALYTICS_WORKSPACE_ID=<LOG_ANALYTICS_WORKSPACE_CUSTOMER_ID>

# ── Optional: Azure DevOps integration (Phase 2 proposals) ─────────
ADO_ORG_URL=
ADO_PROJECT=
ADO_REPO=
# ADO_PAT is a secret. Never commit it. In production, set it as a Key
# Vault reference or protected App Service setting — not in this file.
ADO_PAT=
