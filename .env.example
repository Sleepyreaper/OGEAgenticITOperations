# ─────────────────────────────────────────────────────────────────
# Local / App Service environment configuration — EXAMPLE / TEMPLATE
# ─────────────────────────────────────────────────────────────────
# Copy this file to `.env` (git-ignored — never commit real values) and
# fill in your environment, or run:
#
#   python3 scripts/configure.py
#
# which generates `.env` for you interactively or from CLI flags/an
# answers file. This example file is never modified by that script.
#
# In production (Azure App Service), these are set as App Service
# Application Settings by infra/main.bicep — this file documents them
# for local development and reference.
# ─────────────────────────────────────────────────────────────────

# Which checked-in profile (profiles/<id>/) to load. Defaults to "power"
# (a generic power-utility reference deployment on GPT-5.6 Sol/Terra/Luna
# — see docs/MODEL_CONFIGURATION.md) if unset. Also ships with "generic"
# (a neutral starting point for a new customer/profile) and "oge" (this
# app's original branding/agents, kept as a selectable legacy/example).
APP_PROFILE=power

# ── Azure OpenAI — primary/default ────────────────────────────────
# Endpoint used by any agent that doesn't specify a more specific one.
AZURE_OPENAI_ENDPOINT=https://<YOUR_OPENAI_ACCOUNT>.openai.azure.com/
# Deployment name used when an agent doesn't specify its own.
AZURE_OPENAI_DEPLOYMENT=foundry-gpt
# API version used for chat completions calls unless an agent overrides it.
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── Azure OpenAI — additional named endpoints (optional) ──────────
# "secondary" is a first-class optional slot for a second account/region.
# Any AZURE_OPENAI_ENDPOINT_<NAME> also works and can be referenced from
# an agent's endpoint_ref (profile.json) or AGENT_<KEY>_ENDPOINT=<name>.
AZURE_OPENAI_ENDPOINT_SECONDARY=

# ── Per-agent overrides (all optional; profile defaults apply otherwise) ──
# Agent keys: ORCHESTRATOR, COST_SENTINEL, STANDARDS_ARCHITECT,
#             DIAGNOSTICS_SRE, SCOUT, COMPLIANCE_INSPECTOR
# Each supports: _NAME, _ROLE, _DEPLOYMENT, _ENDPOINT, _TEMPERATURE,
#                _SUPPORTS_TEMPERATURE, _API_VERSION, _PROMPT_FILE
# _ENDPOINT accepts "primary", "secondary", any other AZURE_OPENAI_ENDPOINT_<NAME>,
# or a literal https:// URL.
#
# Examples (uncomment/edit as needed):
# AGENT_ORCHESTRATOR_DEPLOYMENT=foundry-gpt
# AGENT_ORCHESTRATOR_ENDPOINT=secondary
# AGENT_COST_SENTINEL_DEPLOYMENT=foundry-reasoning
# AGENT_COST_SENTINEL_SUPPORTS_TEMPERATURE=true
# AGENT_COST_SENTINEL_TEMPERATURE=0.2
#
# Enforceable token/response/personality controls (see
# docs/MODEL_CONFIGURATION.md): each agent also supports
# _MAX_COMPLETION_TOKENS, _MAX_CONTEXT_CHARS, _RESPONSE_INSTRUCTION,
# _INPUT_COST_PER_MILLION, _OUTPUT_COST_PER_MILLION.
# AGENT_SCOUT_MAX_COMPLETION_TOKENS=400
# AGENT_SCOUT_MAX_CONTEXT_CHARS=12000
# AGENT_SCOUT_RESPONSE_INSTRUCTION=Alert format only: severity, resource, action. 2-4 sentences.
# AGENT_SCOUT_INPUT_COST_PER_MILLION=0.15
# AGENT_SCOUT_OUTPUT_COST_PER_MILLION=0.60
#
# Agent-intelligence layer (see docs/AGENT_INTELLIGENCE.md): each agent
# also supports _PROMPT_VERSION (a free-form version tag; unset falls
# back to a deterministic hash of the loaded system prompt) and
# _SUPPORTS_STRUCTURED_OUTPUT (true/false; whether this agent's
# deployment accepts response_format=json_schema requests -- defaults
# true, and app/agents/backend.py falls back to a plain completion +
# explicit parser either way, so this only skips a doomed-to-fail
# request attempt for a deployment known not to support it).
# AGENT_SCOUT_PROMPT_VERSION=v1
# AGENT_SCOUT_SUPPORTS_STRUCTURED_OUTPUT=true

# ── Agent-intelligence layer (grounded analysis; see
#    docs/AGENT_INTELLIGENCE.md) ────────────────────────────────────
# A single version fingerprint for "this profile's agent definitions as
# currently loaded", surfaced on /api/health and every
# /api/operations/analyze|briefing response. Leave blank (the default)
# to derive one automatically (profile.json's meta.agent_definition_version,
# else a deterministic hash of every agent's resolved prompt_version) --
# set this explicitly only if you want a human-chosen version tag (e.g.
# "v2.1-2026-02") instead of the derived hash.
AGENT_DEFINITION_VERSION=
# Which model backend app/agents/analysis.py uses (see
# app/agents/backend.py). "direct" (the default) calls Azure OpenAI
# directly -- the only backend this app actually implements today.
# "foundry" is NOT implemented and fails loudly (NotImplementedError,
# surfaced as HTTP 501) rather than silently falling back to "direct" --
# see docs/FOUNDRY_ARCHITECTURE.md before ever setting this.
AGENT_BACKEND=direct

# ── Optional: Azure AI Foundry Agent Service metadata (NOT implemented;
#    inert configuration only -- see docs/FOUNDRY_ARCHITECTURE.md) ────
# These are read by app/agents/backend.py::FoundryConfig purely so
# /api/health can honestly report "foundry_configured: true/false" --
# setting them does NOT enable any Foundry runtime behavior. Do not
# provision Azure AI Foundry infrastructure for these until the
# migration in docs/FOUNDRY_ARCHITECTURE.md is actually implemented.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_ID=
FOUNDRY_MODEL_DEPLOYMENT=

# ── Azure environment ───────────────────────────────────────────────
AZURE_CLIENT_ID=<MANAGED_IDENTITY_CLIENT_ID>
AZURE_SUBSCRIPTION_ID=<YOUR_SUBSCRIPTION_ID>
KEY_VAULT_URI=https://<PREFIX>-kv.vault.azure.net/
LOG_ANALYTICS_WORKSPACE_ID=<LOG_ANALYTICS_WORKSPACE_CUSTOMER_ID>

# ── Operations evidence layer (Phase 1; app/operations/, see
#    docs/EVIDENCE_MODEL.md) ─────────────────────────────────────────
# Lookback window (hours) for fired/resolved Azure Monitor alerts
# (Microsoft.AlertsManagement).
ALERT_LOOKBACK_HOURS=24
# Lookback window (hours) for the Activity Log change timeline and
# Resource Health events used for change/health correlation.
CHANGE_LOOKBACK_HOURS=24
# How far (minutes) before a degraded/unavailable Resource Health event
# to look for a preceding write/delete change.
CHANGE_CORRELATION_WINDOW_MINUTES=60
# Usage-percentage thresholds (of the ARM-reported quota limit) for
# Microsoft.Compute and Azure OpenAI/Cognitive Services capacity
# Findings. CAPACITY_WARNING_PCT must be less than CAPACITY_CRITICAL_PCT.
CAPACITY_WARNING_PCT=75
CAPACITY_CRITICAL_PCT=90
# Azure regions the capacity source actually checks (Microsoft.Compute +
# Azure OpenAI/Cognitive Services regional usage) -- a comma-separated
# list of ARM location slugs, e.g. eastus2,westeurope (spaces/hyphens as
# word separators are also accepted and folded to the slug, e.g.
# "East US 2" -> eastus2). Leaving it unset is a valid, safe default --
# the capacity source reports not_configured, exactly as it does when
# calling run_full_collection directly with no locations. Every
# /api/operations/* route (see docs/OPERATIONS_API.md) forwards this
# list as-is; there is no query-string override.
CAPACITY_LOCATIONS=
# Optional, profile-independent noise filter for the capacity source's
# Azure OpenAI/Cognitive Services quota usage (Microsoft.Compute usages
# are NEVER filtered by this setting). A shared Cognitive Services
# account can carry many unrelated, always-fully-allocated model quotas
# (e.g. Claude/image models provisioned for other teams) that would
# otherwise dominate the capacity executive summary; this is a
# comma-separated, case-insensitive substring allowlist applied to each
# quota's name before threshold classification, e.g. gpt-5.6. Leaving
# it unset (the default) means no filtering -- every quota is kept, the
# correct default for a dedicated/generic deployment.
OPENAI_CAPACITY_NAME_FILTERS=
# Configurable workload SLOs (see config/slo_definitions.example.json
# for the schema). Set at most ONE of the two below; setting neither is
# a valid, safe default — the SLO collector reports an explicit
# not_configured state rather than a fabricated uptime number. Setting
# both is a configuration error.
SLO_DEFINITIONS_PATH=
SLO_DEFINITIONS_JSON=

# ── Operations evidence layer (Phase 2 risk/hygiene collectors; see
#    docs/EVIDENCE_MODEL.md and docs/AZURE_DATA_SOURCES.md) ──────────
# Every ENABLE_* flag below defaults to true (the collector runs
# whenever it has enough input to run) -- set to false to deliberately
# turn a source off; its envelope then reports not_configured with a
# clear "disabled via ENABLE_*" message, distinct from "not configured
# because its required input is empty".

# Microsoft Defender for Cloud: active high/medium alerts (posture
# unhealthy assessments are always its own separate source/category --
# see docs/AZURE_DATA_SOURCES.md). No extra input needed.
ENABLE_DEFENDER_ALERTS=true
ENABLE_DEFENDER_ASSESSMENTS=true

# Azure Cost Management. Budget usage-percentage thresholds (of each
# Microsoft.Consumption budget's amount); WARNING must be < CRITICAL,
# like CAPACITY_WARNING_PCT/CAPACITY_CRITICAL_PCT above (but these are
# NOT capped at 100 -- a budget can legitimately be over-spent).
COST_BUDGET_WARNING_PCT=80
COST_BUDGET_CRITICAL_PCT=100
# The cost-trend collector is a deterministic period-over-period
# actual-cost comparison (NOT Cost Management's native anomaly
# detection -- see docs/AZURE_DATA_SOURCES.md for why). Growth vs. the
# prior period of equal length must reach this percentage to raise a
# Finding.
COST_TREND_LOOKBACK_DAYS=30
COST_TREND_GROWTH_PCT_THRESHOLD=20
ENABLE_COST_MANAGEMENT_BUDGET=true
ENABLE_COST_MANAGEMENT_TREND=true

# Azure Backup. Reads the Log Analytics tables Azure Backup's
# diagnostic settings populate (AddonAzureBackupJobs/CoreAzureBackup) --
# see docs/AZURE_DATA_SOURCES.md for that assumption.
BACKUP_LOOKBACK_HOURS=24
BACKUP_STALE_RECOVERY_POINT_DAYS=3
ENABLE_BACKUP=true

# Azure Update Manager (Resource Graph patchassessmentresources table).
# Resource Graph itself only retains 7 days of assessment history, so
# the default staleness threshold matches that retention window.
PATCH_ASSESSMENT_STALE_DAYS=7
ENABLE_UPDATE_MANAGER=true

# Key Vault certificate/secret/key expiry (metadata-only List APIs --
# values are never read). KEY_VAULT_MONITOR_URIS is a comma-separated
# list of vault URIs to check; leaving it unset is a valid, safe
# default (the source reports not_configured -- no vaults implicitly
# scanned).
KEY_VAULT_EXPIRY_WARNING_DAYS=30
KEY_VAULT_MONITOR_URIS=
KEY_VAULT_MAX_ITEMS_PER_TYPE=200
ENABLE_KEY_VAULT_EXPIRY=true

# Azure Automation job failures. AUTOMATION_ACCOUNT_IDS is a
# comma-separated list of Automation Account ARM resource ids; leaving
# it unset is a valid, safe default (not_configured -- no accounts
# implicitly discovered/scanned).
AUTOMATION_LOOKBACK_HOURS=24
AUTOMATION_ACCOUNT_IDS=
ENABLE_AUTOMATION=true

# Telemetry coverage gaps (diagnostic settings + Log Analytics
# heartbeat). TELEMETRY_MONITORED_RESOURCE_TYPES bounds Resource Graph
# discovery to a curated allowlist (defaults to a sensible built-in list
# -- see app/operations/config.py -- if left unset);
# TELEMETRY_CRITICAL_RESOURCE_IDS lets you pin specific resource ids
# regardless of type. TELEMETRY_MAX_RESOURCES bounds the total number of
# per-resource diagnostic-settings ARM calls made in one run.
TELEMETRY_MONITORED_RESOURCE_TYPES=
TELEMETRY_CRITICAL_RESOURCE_IDS=
TELEMETRY_MAX_RESOURCES=50
TELEMETRY_HEARTBEAT_LOOKBACK_HOURS=24
ENABLE_TELEMETRY_COVERAGE=true

# Retirement/deprecation advisories (Service Health HealthAdvisory
# events via Resource Graph's ServiceHealthResources table).
# RETIREMENT_WARNING_DAYS is the threshold below which an advisory's
# published mitigation deadline is treated as high severity.
RETIREMENT_WARNING_DAYS=180
ENABLE_RETIREMENT_ADVISORIES=true

# ── Operations product API (snapshot/brief/queue/workflow-state/
#    handoff; see docs/OPERATIONS_API.md) ───────────────────────────
# How long (seconds) a built operations snapshot is served from the
# in-process cache before the next request rebuilds it from Azure,
# keyed by the normalized subscription selection. Explicit
# ?refresh=true always bypasses this. Must be positive.
OPERATIONS_SNAPSHOT_CACHE_TTL_SECONDS=60
# SQLite file path for the finding workflow-state store (status/owner/
# snooze/audit history -- see app/operations/state.py). The default
# below is a local, working-directory-relative path suitable for local
# dev. On Azure App Service (Linux), set this to a path under /home --
# the only path persisted across restarts/scale events on that
# platform -- e.g. /home/data/operations.db (infra/main.bicep's
# operationsSettings.operationsStateDbPath wires this for a real
# deploy).
OPERATIONS_STATE_DB=operations_state.db

# ── Telemetry (optional; see docs/TELEMETRY.md) ─────────────────────
# Azure Monitor OpenTelemetry is disabled (a normal local-dev state)
# unless this connection string is set. It's a secret — treat it like
# one (it permits telemetry injection into your Application Insights
# resource); in production, set it as a protected App Service setting
# (infra/main.bicep already wires this from the provisioned App
# Insights resource — you don't need to set it here for a real deploy).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional service.name override. Blank = the app derives
# "ops-council-<APP_PROFILE>" automatically at startup.
OTEL_SERVICE_NAME=

# ── Optional: Azure DevOps integration (Phase 2 proposals) ─────────
ADO_ORG_URL=
ADO_PROJECT=
ADO_REPO=
# ADO_PAT is a secret. Never commit it. In production, set it as a Key
# Vault reference or protected App Service setting — not in this file.
ADO_PAT=
