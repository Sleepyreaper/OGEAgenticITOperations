*.bicepparam

# Local deployment artifacts generated by scripts/configure.py.
# Checked-in *.example templates are exempt.
.env
.env.*
!.env.example
!*.bicepparam.example

# Local finding workflow-state SQLite store (app/operations/state.py) --
# per-environment data, never checked in.
*.db
*.db-wal
*.db-shm
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Terraform local state/artifacts (infra/terraform/)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
